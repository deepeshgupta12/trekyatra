# Google OAuth (Step 09)
# Create OAuth 2.0 credentials at Google Cloud Console (Web application type)
# Authorized JavaScript origins: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here

# Google AdSense (Step 20)
# Set this to your AdSense publisher ID to enable real ad serving.
# If unset, ad slots render clearly-labelled dev placeholders (no external script loaded).
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ID=

# Google Analytics 4 (Step 24)
# Set to your GA4 Measurement ID to enable event tracking (pageviews + custom events).
# If unset, no GA4 scripts are loaded and trackEvent() silently no-ops.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Google Search Console verification
# Get this from search.google.com/search-console → Add property → HTML tag method
# Copy ONLY the content="" value (without quotes), e.g. abc123XYZ
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Site URL (used for canonical tags and JSON-LD schema)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (Step 34) — publishable key for Razorpay.js checkout embed
# Get test keys at https://dashboard.razorpay.com/app/keys
# Leave blank to run in test mode (payments simulate without real transaction)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Stripe (Step 40) — publishable key for Stripe.js checkout redirect
# Get test keys at https://dashboard.stripe.com/apikeys
# Leave blank to run in test mode (redirects to success page without real billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
