# TrekYatra Mobile App — Environment Variables
# Copy this file to .env.local (never commit .env.local)

# Backend API base URL (no trailing slash)
# Development: http://localhost:8000
# Production:  https://api.trekyatra.co.in
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Client ID for expo-auth-session
# Create at console.cloud.google.com → Credentials → OAuth 2.0 Client ID (type: Android/iOS)
# Add redirect URI: com.trekyatra.app:/oauth2redirect
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Sentry DSN for React Native error tracking
# Get from sentry.io → Project → Settings → Client Keys (DSN)
# Leave empty to disable Sentry in development
EXPO_PUBLIC_SENTRY_DSN=

# Razorpay Key ID (test or live)
# Get from dashboard.razorpay.com → Settings → API Keys
# Use test key (rzp_test_*) for development, live key (rzp_live_*) for production
# Note: Razorpay requires an EAS development build — does not work in Expo Go
EXPO_PUBLIC_RAZORPAY_KEY_ID=
