APP_NAME=TrekYatra API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=trekyatra
POSTGRES_USER=trekyatra
POSTGRES_PASSWORD=trekyatra
# Production (DigitalOcean) — set these in DO App Platform env vars:
# POSTGRES_SERVER=trekyatra-db-do-user-37216682-0.m.db.ondigitalocean.com
# POSTGRES_PORT=25060   ← auto-enables sslmode=require
# POSTGRES_DB=trekyatra
# POSTGRES_USER=trekyatra_user
# POSTGRES_PASSWORD=<trekyatra_user password from DO dashboard>

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=
# Production (DigitalOcean) — set these in DO App Platform env vars:
# REDIS_HOST=db-valkey-blr1-95254-do-user-37216682-0.m.db.ondigitalocean.com
# REDIS_PORT=25061        ← auto-enables rediss:// (TLS)
# REDIS_USERNAME=default
# REDIS_PASSWORD=<password from DO dashboard → Valkey → Connection Details → show>

# Celery — broker and result backend use Redis DB 1 (separate from cache on DB 0)
# Derived automatically from REDIS_HOST/REDIS_PORT; override here if needed
# CELERY_BROKER_URL=redis://localhost:6380/1
# CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Master CMS — no external service required; uses cms_pages table in Postgres
# Cache stored in Redis DB 2 (5-min TTL). No additional config needed.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic — required for all LLM agent steps (Step 12+)
ANTHROPIC_API_KEY=sk-ant-replace-me

# OpenAI — required for content embeddings (Step 35+)
# Leave unset to skip embedding generation (recommendations fall back to freshness sort)
OPENAI_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=

AUTH_JWT_SECRET=trekyatra-dev-secret-key-at-least-32-bytes-long
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=trekyatra_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# CMS Admin credentials — completely separate from public user auth
# Set ADMIN_PASSWORD to enable admin login. Leave unset to disable CMS access.
# Admin login available at /admin/sign-in (separate from public /auth/sign-in)
ADMIN_EMAIL=explore@trekyatra.co.in
ADMIN_PASSWORD=
ADMIN_COOKIE_NAME=trekyatra_admin_token
ADMIN_TOKEN_EXPIRE_HOURS=24

# Frontend base URL — used when building links inside emails (e.g. verification link)
FRONTEND_URL=https://trekyatra.co.in

# SMTP — transactional emails (welcome, lead notify, email verification, alerts).
# GoDaddy: SMTP_HOST=smtpout.secureserver.net, SMTP_PORT=587 (STARTTLS)
# Leave blank to disable email sending (all tasks gracefully skip).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=explore@trekyatra.co.in
SMTP_PASSWORD=
SMTP_FROM_EMAIL=explore@trekyatra.co.in

# Newsletter platform — mailchimp | brevo. Leave blank to disable external sync.
NEWSLETTER_PLATFORM=
NEWSLETTER_PLATFORM_API_KEY=
NEWSLETTER_LIST_ID=

# Payment — Razorpay (India-first). Get keys at https://razorpay.com
# Leave unset to run in test mode (payments simulate without real transaction).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe — recurring subscription billing (Step 40)
# Get keys at https://dashboard.stripe.com/apikeys
# Leave unset to run in test mode (checkout redirects to success page without real billing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID_MONTHLY=
STRIPE_PREMIUM_PRICE_ID_ANNUAL=

# Digital product files — local path relative to services/api/ directory
# Create this directory and place product files inside.
PRODUCT_FILES_DIR=data/products
PRODUCT_DOWNLOAD_BASE_URL=http://localhost:3000

# DigitalOcean Spaces — persistent media storage for CMS image uploads
# 1. Create a Space at cloud.digitalocean.com/spaces (choose BLR1 region)
# 2. Generate Spaces API keys at cloud.digitalocean.com/account/api > Spaces Keys
# 3. Enable CDN on the Space for better performance
# If unset: uploads stored locally (lost on next deployment — for dev only)
# Step 44 — Search analytics (no API key needed; search_events table captures queries)
# Step 45 — Image Gathering Agent (all optional; graceful skip when unset)
# Unsplash: create app at https://unsplash.com/developers → copy Access Key
UNSPLASH_ACCESS_KEY=
# Pixabay: free signup at https://pixabay.com/api/docs → copy API Key
PIXABAY_API_KEY=

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=trekyatra-media
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_SPACES_REGION=blr1
DO_SPACES_CDN_ENDPOINT=https://trekyatra-media.blr1.cdn.digitaloceanspaces.com
# Step 64 — CDP Analytics Layer
# GA4 Measurement Protocol (server-side, bypasses ad blockers)
# Get from Google Analytics > Admin > Data Streams > Measurement Protocol API secrets
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=
# Google Search Console API — service account JSON (paste raw JSON string, no line breaks)
# 1. Create service account at console.cloud.google.com
# 2. Grant it "Verified Owner" in GSC for sc-domain:trekyatra.co.in
# 3. Download JSON key, paste as single-line string below
GSC_SERVICE_ACCOUNT_JSON=

# Step 67 — CDP Phase 0: internal traffic separation
# Comma-separated list of anonymous_ids for developers/internal team (marked is_internal=true)
INTERNAL_ANONYMOUS_IDS=

# Steps M02 + M03 — Mobile App Bearer token lifetime
# Mobile access tokens are long-lived compared to web (30 days vs 24h)
MOBILE_TOKEN_EXPIRE_DAYS=30

# Step 72 — TrekSage MCP server: shared secret gating write/LLM-cost MCP tools
# (create_trek_plan_lead, translate_trek_content) when called via /mcp with header X-MCP-Key.
# Leave unset to disable those two tools over MCP (read-only tools remain open).
MCP_SHARED_SECRET=
